@{
    var path = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    var pageTitle = ViewData["Title"] ?? "AgentSupervisor";
}
<!doctype html>
<html lang="ja" data-theme="">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>const savedTheme=localStorage.getItem('agentsupervisor-theme');if(savedTheme==='light'||savedTheme==='dark')document.documentElement.dataset.theme=savedTheme;</script>
    <link rel="stylesheet" href="/css/app.css" />
    <title>@pageTitle</title>
</head>
<body>
    <aside class="sidebar">
        <div class="brand">Agent Supervisor</div>
        <nav class="sidebar-nav" aria-label="メインナビゲーション">
            <a href="/" class="@(path == "" ? "active" : "")" aria-current="@(path == "" ? "page" : null)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><polyline points="3 12 8 12 10 18 14 6 16 12 21 12"/></svg><span>Sessions</span></a>
            <a href="/Projects" class="@(path.Equals("/Projects", StringComparison.OrdinalIgnoreCase) ? "active" : "")" aria-current="@(path.Equals("/Projects", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg><span>Projects</span></a>
            <a href="/Tasks" class="@(path.Equals("/Tasks", StringComparison.OrdinalIgnoreCase) ? "active" : "")" aria-current="@(path.Equals("/Tasks", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><path d="M9 6h11M9 12h11M9 18h11"/><path d="M3 6l1.5 1.5L7 5"/><path d="M3 12l1.5 1.5L7 11"/><path d="M3 18l1.5 1.5L7 17"/></svg><span>Tasks</span></a>
            <a href="/Questions" class="@(path.Equals("/Questions", StringComparison.OrdinalIgnoreCase) ? "active" : "")" aria-current="@(path.Equals("/Questions", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.8.4-1.3 1-1.3 1.7"/><line x1="12" y1="17" x2="12" y2="17.01"/></svg><span>Questions</span></a>
            <a href="/Settings" class="@(path.Equals("/Settings", StringComparison.OrdinalIgnoreCase) ? "active" : "")" aria-current="@(path.Equals("/Settings", StringComparison.OrdinalIgnoreCase) ? "page" : null)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" width="20" height="20"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg><span>Settings</span></a>
        </nav>
    </aside>
    <main class="main-area">
        <header class="top-bar">
            <h1 class="page-title">@pageTitle</h1>
            <div class="top-actions">
                <span id="connection-status" class="status-pill status-neutral" role="status" aria-live="polite"><span class="status-dot"></span>切断</span>
                <button id="theme-toggle" type="button" aria-label="配色を切り替え">☾</button>
            </div>
        </header>
        @RenderBody()
    </main>
    <script src="/lib/signalr/signalr.min.js"></script>
    <script src="/js/app.js"></script>
</body>
</html>
